+        ax3.text(0.5, 0.5, 'N/A', transform=ax3.transAxes, ha='center')
+    ax3.set_xlabel('Band index')
+    ax3.set_title('Per-Band Predictability')
+
+    # SNR
+    ax4 = axes[1, 1] if ax is None else axes[3]
+    if band_snrs is not None:
