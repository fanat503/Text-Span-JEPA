+  decoder_bias: false
+  variance_margin: 1.0
+  centering_momentum: 0.9
+  ema_tau_start: 0.996
+  ema_tau_end: 0.9999
+  ema_schedule: cosine
+  lambda_span: 1.0
+  lambda_future: 0.5
+  lambda_decoder: 0.1
+  lambda_variance: 0.1
+  lambda_covariance: 0.04
+  mask_ratio_start: 0.15
+  mask_ratio_end: 0.35
+  future_warmup_steps: 5000
+  use_jawp: true
+  jawk_k_start: 1
+  jawk_k_end: null
+  jawk_curriculum_steps: 10000
+  jawk_alpha: 0.1
+  jawk_init: identity
+  lambda_predictive_rank: 0.0
+  use_cgn: false
+  cgn_n_groups: 8
+  cgn_tau_start: 1.0
+  cgn_tau_end: 0.1
+  cgn_anneal_steps: 10000
+  lambda_cgn_ortho: 0.0
+  use_swip: false
