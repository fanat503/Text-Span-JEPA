+    ax.set_xlabel('Eigenvalue index')
+    ax.set_ylabel('Eigenvalue (log scale)')
+    ax.set_title(title)
+    ax.legend(fontsize=8)
+
+    if save_path:
+        fig.savefig(save_path)
+    return fig, ax
